import { Database } from "bun:sqlite"
import { readFileSync } from "fs"
import { join, dirname } from "path"

export const PATLIB_ROOT = process.cwd()
export const DB_PATH = join(PATLIB_ROOT, "patlib.db")
export const SCHEMA_PATH = join(PATLIB_ROOT, ".opencode", "_schemas", "patlib.sql")
export const PATTERNS_DIR = join(PATLIB_ROOT, ".opencode", "patterns")
export const TERMS_DIR = join(PATLIB_ROOT, ".opencode", "terms")
export const SKILLS_DIR = join(PATLIB_ROOT, ".opencode", "skills")
export const APOLOGIAS_DIR = join(PATLIB_ROOT, ".opencode", "apologias")
export const RULES_DIR = join(PATLIB_ROOT, ".opencode", "rules", "yamls")
export const COMMANDS_YAML_DIR = join(PATLIB_ROOT, ".opencode", "commands", "yamls")
export const ABSTRACTIONS_DIR = join(PATLIB_ROOT, ".opencode", "abstractions")
export const MCP_DB_PATH = join(PATLIB_ROOT, "mcp-search.db")
export const MCP_SCHEMA_PATH = join(PATLIB_ROOT, ".opencode", "_schemas", "mcp.sql")

export function initDB(): Database {
  const db = new Database(DB_PATH)
  const schema = readFileSync(SCHEMA_PATH, "utf-8")
  db.exec(schema)
  return db
}

export function initMCPDB(): Database {
  const db = new Database(MCP_DB_PATH)
  const schema = readFileSync(MCP_SCHEMA_PATH, "utf-8")
  db.exec(schema)
  return db
}

export function queryAll(db: Database, sql: string, params?: Record<string, unknown>): Record<string, unknown>[] {
  return db.query(sql).all(params) as Record<string, unknown>[]
}

export function queryOne(db: Database, sql: string, params?: Record<string, unknown>): Record<string, unknown> | null {
  return db.query(sql).get(params) as Record<string, unknown> | null ?? null
}
