#!/usr/bin/env bash
# test-one.sh {file} — run ONE _scripts/ executable atomically; output to tmp file, force-kill on timeout
set -uo pipefail
cd /home/eddyr/assembler/.opencode/_scripts
F="${1:?file required}"
TMPF="/tmp/opencode/test-out.txt"
case "$F" in
  *.rb) runner="ruby" ;;
  *.pl) runner="perl" ;;
  *.sh) runner="bash" ;;
esac
case "$F" in
  r6-patlib-sync.rb) args="--type cli --dry" ;;
  r0-run-parallel.rb) args="--help" ;;
  *) args="" ;;
esac
timeout -k 3 10 "$runner" "$F" $args </dev/null >"$TMPF" 2>&1
st=$?
if [ $st -eq 0 ]; then
  echo "PASS $F"
elif [ $st -eq 124 ] || [ $st -eq 137 ]; then
  echo "TIMEOUT $F"
else
  echo "FAIL($st) $F"
  head -3 "$TMPF" | sed 's/^/    /'
fi
