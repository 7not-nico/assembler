# CMD: bash -c $'cd /home/eddyr/assembler\ndeclare -A MAP=(\n [PROT.COGNITION.IDENTITY.SCHEMA]=PROT.COGNITION.SCHEMA\n [PROT.MAXIM.IDENTITY.SCHEMA]=PROT.MAXIM.SCHEMA\n [PROT.COGNITION.IDENTITY]=PROT.COGNITION.SCHEMA\n [PROT.MAXIM.IDENTITY]=PROT.MAXIM.SCHEMA\n [PROT.SKILL.IDENTITY]=PROT.SKILL.SCHEMA\n [PROT.TOOL.PROJECT.SCOPE]=PROT.TOOL.SCOPE\n [PROT.TOOL.MORPHISM.COMPOSITE]=PROT.TOOL.COMPOSITE\n [PROT.TOOL.PLUGIN.VALIDATION]=PROT.TOOL.COMPLIANCE\n)\nfind . -name "*.md" -not -path "*/.git/*" -not -path "*/node_modules/*" -not -path "*/target/*" > /tmp/opencode/all-md.txt\nfor old in $(printf "%s\\n" "${!MAP[@]}" | awk "{ print length, \\$0 }" | sort -rn | cut -d" " -f2-); do\n  new=${MAP[$old]}\n  esc=$(printf "%s" "$old" | sed "s/\\./\\\\\\\\./g")\n  hits=$(grep -rl -- "$old" $(cat /tmp/opencode/all-md.txt) 2>/dev/null | wc -l)\n  if [ "$hits" -gt 0 ]; then\n    grep -rl -- "$old" $(cat /tmp/opencode/all-md.txt) 2>/dev/null | xargs -r sed -i "s/$esc/$new/g"\n    echo "MAP $old -> $new ($hits files)"\n  fi\ndone\n# judgment: layer-choice scoped to the one illustration\nsed -i "s/PROT.TOOL.LAYER.CHOICE/NEX.TOOL.CHOICE/g" .opencode/entities/illustrations/ILL.TRACER.PATH.md\necho "MAP PROT.TOOL.LAYER.CHOICE -> NEX.TOOL.CHOICE (ILL.TRACER.PATH.md)"' 
