#!/usr/bin/env python3
"""bitacora — the bitacora flow as one typed binary.

Subcommands:
  bitacora todo   {topic} ["{desc}"]            — open a task-todo record
  bitacora run    {name} [--trace] -- {cmd...}  — frame a command's output
  bitacora report {topic} ["{desc}"]            — open a task-report record

Walks up from its own location to the _codex root (canonical + dive copies
resolve). Records live under _codex/_bitacora/{task-todo,task-stdout,
task-report}/. Framing: # CMD:/# DATE:/# CWD: header, live tee, then
# DUR:/# DATE:/# exit: tail. No-clobber per topic. Exit: framed command's
status on run; 0 on record open; 1 on errors; 2 on usage.
"""

from __future__ import annotations

import os
import subprocess
import sys
import time
from pathlib import Path
from typing import NoReturn


def codex_root(start: Path) -> Path:
    """Walk up from start to the _codex ancestor."""
    d = start.resolve()
    while True:
        if d.name == "_codex":
            return d
        if d.parent == d:
            raise RuntimeError(f"no _codex ancestor above {start}")
        d = d.parent


def record_open(subdir: str, topic: str) -> Path:
    """Open a record under _codex/_bitacora/{subdir}, no-clobber per topic."""
    root = codex_root(Path(__file__).parent)
    rec_dir = root / "_bitacora" / subdir
    rec_dir.mkdir(parents=True, exist_ok=True)
    existing = sorted(rec_dir.glob(f"*-{topic}.md"))
    if existing:
        raise RuntimeError(f"{subdir} record exists: {existing[0]}")
    ts = time.strftime("%Y%m%d-%H%M%S")
    return rec_dir / f"{ts}-{topic}.md"


def write_record(path: Path, body: str) -> None:
    path.write_text(body)


def cmd_todo(topic: str, desc: str) -> int:
    path = record_open("task-todo", topic)
    body = (
        f"# {topic} — todo\n\n"
        f"**Date:** {time.strftime('%Y-%m-%d')}\n"
        f"**Project:** {desc}\n\n"
        f"## Tasks\n\n"
    )
    write_record(path, body)
    print(f"TODO={path}")
    return 0


def cmd_report(topic: str, desc: str) -> int:
    path = record_open("task-report", topic)
    body = (
        f"# {path.stem} — {topic} close-out\n\n"
        f"**Date:** {time.strftime('%Y-%m-%d')}\n"
        f"**Project:** {desc}\n\n"
        "## What happened\n\n"
        "## Decisions\n\n"
        "## Verification\n\n"
        "## Open edges\n\n"
        "## Todo state\n\n"
    )
    write_record(path, body)
    print(f"REPORT={path}")
    return 0


def cmd_run(name: str, trace: bool, cmd: list[str]) -> int:
    if not cmd:
        print("command required", file=sys.stderr)
        return 2
    root = codex_root(Path(__file__).parent)
    stdout_dir = root / "_bitacora" / "task-stdout"
    stdout_dir.mkdir(parents=True, exist_ok=True)
    ts = time.strftime("%Y%m%d-%H%M%S")
    log_path = stdout_dir / f"{ts}-{name}.log"

    quoted = " ".join(f'"{c}"' for c in cmd)
    header = (
        f"# CMD: {quoted}\n"
        f"# DATE: {time.strftime('%Y-%m-%dT%H:%M:%S%z')}\n"
        f"# CWD: {os.getcwd()}\n"
        "# --------------------\n"
    )
    with log_path.open("a") as fh:
        fh.write(header)
    print(header, end="")

    argv = ["tracexec", "log", "--", *cmd] if trace else cmd
    start = time.monotonic()
    try:
        proc = subprocess.run(argv, stdin=None)
    except FileNotFoundError:
        print(f"ERROR command not found: {cmd[0]}", file=sys.stderr)
        status = 127
    else:
        status = proc.returncode
    dur_ms = int((time.monotonic() - start) * 1000)

    tail = (
        f"# DUR: {dur_ms}ms\n"
        f"# DATE: {time.strftime('%Y-%m-%dT%H:%M:%S%z')}\n"
        f"# exit: {status}\n"
    )
    with log_path.open("a") as fh:
        fh.write(tail)
    print(tail, end="")
    return status


def usage() -> NoReturn:
    print(
        "usage: bitacora {todo|run|report} ...\n"
        "  bitacora todo   {topic} [\"{desc}\"]\n"
        "  bitacora run    {name} [--trace] -- {cmd...}\n"
        "  bitacora report {topic} [\"{desc}\"]",
        file=sys.stderr,
    )
    sys.exit(2)


def main(argv: list[str]) -> int:
    if not argv:
        usage()
    sub = argv[0]
    try:
        if sub == "todo":
            if len(argv) < 2:
                usage()
            return cmd_todo(argv[1], argv[2] if len(argv) > 2 else argv[1])
        if sub == "report":
            if len(argv) < 2:
                usage()
            return cmd_report(argv[1], argv[2] if len(argv) > 2 else argv[1])
        if sub == "run":
            if len(argv) < 3:
                usage()
            name = argv[1]
            rest = argv[2:]
            trace = False
            if rest and rest[0] == "--trace":
                trace = True
                rest = rest[1:]
            if not rest or rest[0] != "--":
                usage()
            return cmd_run(name, trace, rest[1:])
    except RuntimeError as e:
        print(f"ERROR {e}", file=sys.stderr)
        return 1
    usage()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
