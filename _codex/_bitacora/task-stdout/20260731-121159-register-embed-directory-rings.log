# CMD: sh -c $'cd /home/eddyr/assembler && bun -e \'\nimport { Database } from "bun:sqlite"\nconst db = new Database(".opencode/patlib.db")\nconst id = "SPEC.DIRECTORY.RING.TOPOLOGY"\nconst title = "Directory Ring Topology — R0 Root, R1 Domains, R2 Infrastructure, R3 Projects"\nconst body = "**Directory Ring Topology** — every folder in the assembler belongs to one of four ordinal rings by position and underscore prefix. Ring 0 is the assembler root. Ring 1 holds underscore-prefixed domain folders directly in the root. Ring 2 holds underscore-prefixed folders inside a domain. Ring 3 holds plain folders inside a domain. The underscore prefix carries the ring signal.\\n\\n## Rings\\n\\n- R0 — assembler root — the top-level directory. It holds AGENTS.md, .opencode/, report/, and reference/. Root-level files and infrastructure live here.\\n- R1 — domain folders — underscore-prefixed folders directly in the root: _code-dives/, _knowledge/, _assets/, _findings/. The underscore prefix marks a domain.\\n- R2 — domain infrastructure — underscore-prefixed folders inside a domain: _code-dives/_templates/, _code-dives/_bitacora/, _knowledge/_templates/. The underscore prefix marks infrastructure and records.\\n- R3 — domain projects — plain folders inside a domain: _code-dives/snes9x-repo/, _knowledge/rust-coding/. A plain name marks a project or content folder.\\n\\n## Ring constraints\\n\\n- The underscore prefix signals the ring: R1 and R2 use underscores; R3 uses plain names. A folder never mixes the signals.\\n- Ring order governs governance: R0 root instructions govern; R1 domains follow; R2 infrastructure serves the domain; R3 projects sit at the leaves.\\n- A ring-3 project may carry its own AGENTS.md; the project instructions describe the project alone, per SPEC.AGENTS.SELF.CONTAINED.\\n- The code ring system governs what lives inside .opencode/_scripts/; this ring system governs where folders sit.\\n\\n## Applicability\\n\\nAll directory placement in the assembler: domain creation, infrastructure folders, and project folders."\nconst summary = "Four ordinal directory rings govern folder placement: R0 assembler root, R1 underscore-prefixed domains in the root, R2 underscore-prefixed infrastructure inside domains, R3 plain project folders inside domains. The underscore prefix carries the ring signal."\ndb.query("INSERT INTO specifications (id, title, body, source, summary, tags, created, modified) VALUES (?, ?, ?, ?, ?, ?, datetime(\\"now\\"), datetime(\\"now\\"))").run(id, title, body, "assembler", summary, "directory,ring,topology,folder,placement,domain,specification")\nconsole.log("inserted", db.query("SELECT id FROM specifications WHERE id=?").get(id))\n\' && bun run .opencode/tools/semantic-embed.ts --type specifications && bun run .opencode/tools/semantic-search.ts --query "directory rings root domains underscore infrastructure projects" --k 2 --type specifications' 
