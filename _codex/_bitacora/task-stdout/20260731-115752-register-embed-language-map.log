# CMD: sh -c $'cd /home/eddyr/assembler && bun -e \'\nimport { Database } from "bun:sqlite"\nconst db = new Database(".opencode/patlib.db")\nconst id = "SPEC.LANGUAGE.ROLE.MAP"\nconst title = "Language Role Map — Ruby Schemas, Rust/Go Systems, Bash Shells, TypeScript Extension"\nconst body = "**Language Role Map** — each language owns one role in the workspace. Ruby handles script tasks grounded in schemas and SQL. Rust and Go handle systems and high-performance logic. Bash handles imperative shells. TypeScript extends OpenCode functionality. The role determines the language choice; a task selects its language by its layer, not by preference.\\n\\n## Rule\\n\\n- Ruby — schema-grounded scripts — Ruby processes script tasks in the _scripts/ and script/ folders. Scripts read and write through the schema — .sql definitions, bun:sqlite/sqlite3 databases, registry tables. Functional style governs the code. The script\\"s data model lives in its schema; the script executes that model.\\n- Rust and Go — systems and high-performance logic — Rust powers core logic where speed and safety bind: ANN backends, binary transports, computational kernels. Go serves the same role where concurrency and compile speed favor it — goroutine-parallel workers, binary-transport services. Both speak binary protocols at scale; serialization dominates otherwise.\\n- Bash — imperative shells — Bash forms binary imperative shells: tool wrappers, orchestration, and automation scripts. It clones repos, pipes logs, moves files, and sequences commands. Each shell performs one imperative task; guards and clear exit codes govern it.\\n- TypeScript — OpenCode extension — TypeScript extends OpenCode functionality: custom IPC tools, plugins, and MCP servers under .opencode/tools/ with shared _lib/ modules. Static types construct the imperative shell around the engine; the engine\\"s core logic stays in Rust.\\n\\n## Selection test\\n\\n- The task manipulates schema-backed data through SQL → Ruby.\\n- The task needs raw speed, binary transport, or a computational kernel → Rust or Go.\\n- The task sequences commands, files, and processes → Bash.\\n- The task extends the OpenCode agent runtime → TypeScript.\\n\\n## Applicability\\n\\nAll code in the workspace: root tooling, project scripts, template infrastructure, and subproject toolchains."\nconst summary = "Ruby processes schema-grounded script tasks. Rust and Go power systems and high-performance logic with binary transports. Bash forms imperative shells for orchestration. TypeScript extends OpenCode functionality via IPC tools, plugins, and MCP servers."\ndb.query("INSERT INTO specifications (id, title, body, source, summary, tags, created, modified) VALUES (?, ?, ?, ?, ?, ?, datetime(\\"now\\"), datetime(\\"now\\"))").run(id, title, body, "assembler", summary, "language,role,selection,ruby,rust,go,bash,typescript,specification")\nconsole.log("inserted", db.query("SELECT id FROM specifications WHERE id=?").get(id))\n\' && bun run .opencode/tools/semantic-embed.ts --type specifications && bun run .opencode/tools/semantic-search.ts --query "language role ruby sql rust performance bash shell typescript opencode" --k 2 --type specifications' 
