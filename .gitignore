# runtime artifacts
opencode.json
*.db
*.db-shm
*.db-wal
node_modules/

# browser session logs
.playwright-mcp/

# codex upstream clones (own git repos)
_codex/*-repo/*/

# trove research captures (binary)
_trove/_captures/
_trove/**/*.pdf

# depot media binaries
_depot/art/
_depot/photo/
_depot/draw/

# scripts build artifacts + generated output
.opencode/_scripts/_golib/bin/
.opencode/_scripts/_bin/target/
.opencode/_scripts/_rs/target/
.opencode/_scripts/report/
.opencode/_rustlib/target/
.opencode/_rustlib/_disabled/target/

# runtime crash artifacts + state
*.db.*
.opencode/.burst-state.json

# backup snapshot dirs (rule/skill pre-rewrite copies)
.backups/
**/_backups/

# compound aggregator domains — _{abstract-noun}/ folders
# domain project contents live in their own repos; the root repo tracks
# the substrate _folders — bitacora, templates, impressions, scripts —
# with their contents, plus top-level placeholders
/_*/
/_*/*
!/_*/
!/_*/_bitacora/
!/_*/_bitacora/**
!/_*/_templates/
!/_*/_templates/**
!/_*/_impressions/
!/_*/_impressions/**
!/_*/_scripts/
!/_*/_scripts/**
!/_*/.gitkeep

# _atelier/gzdoom-launcher — atelier project source tracked; binaries + runtime stay out
!/_atelier/gzdoom-launcher/
!/_atelier/gzdoom-launcher/**
/_atelier/gzdoom-launcher/**/.venv/
/_atelier/gzdoom-launcher/**/__pycache__/
/_atelier/gzdoom-launcher/wad/
/_atelier/gzdoom-launcher/map/
/_atelier/gzdoom-launcher/mod/
/_atelier/gzdoom-launcher/save/
/_atelier/gzdoom-launcher/BrutalDoomPlatinum/
/_atelier/gzdoom-launcher/ZScript.epub
/_atelier/gzdoom-launcher/PythonRef.epub
/_atelier/gzdoom-launcher/PythonLibRef.epub
/_atelier/gzdoom-launcher/script/epub-maker/tmp/
/_atelier/gzdoom-launcher/script/epub-maker/tmp-lib/
/_atelier/gzdoom-launcher/script/epub-maker/schema/pages.sql
/_atelier/gzdoom-launcher/script/epub-maker/schema/lib-pages.sql
/_atelier/gzdoom-launcher/script/epub-maker/schema/lib-sections.sql
/_atelier/gzdoom-launcher/schema/wads.db
/_atelier/gzdoom-launcher/fixture/sample/*.zip

# build artifacts inside tracked _folders stay out
**/_rustlib/target/
**/_golib/ann
**/_shared/bin/

# _codex/snes9x-repo — crystal launcher source tracked; dive contents + binary stay out
!/_codex/snes9x-repo/
!/_codex/snes9x-repo/AGENTS.md
!/_codex/snes9x-repo/scripts/
!/_codex/snes9x-repo/scripts/snes9x-launcher.cr
/_codex/snes9x-repo/scripts/snes9x-launcher

# binary DBs inside tracked _folders stay out (substrate un-ignore re-includes _templates/**)
_knowledge/_templates/schema/*.db
_knowledge/_templates/schema/*.db-shm
_knowledge/_templates/schema/*.db-wal

# pdf research documents stay out
_trove/**/*.pdf



# node_modules stay out everywhere (after substrate un-ignore)
**/node_modules/
**/__pycache__/

# python venvs (uv-managed)
**/.venv/
