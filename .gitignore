# runtime artifacts
opencode.json
*.db
*.db-shm
*.db-wal
node_modules/

# browser session logs
.playwright-mcp/

# codex upstream clones (own git repos)
_codex/*-repo/*/

# trove research captures (binary)
_trove/_captures/
_trove/**/*.pdf

# depot media binaries
_depot/art/
_depot/photo/
_depot/draw/

# scripts build artifacts + generated output
.opencode/_scripts/_golib/bin/
.opencode/_scripts/_bin/target/
.opencode/_scripts/_rs/target/
.opencode/_scripts/report/
.opencode/_rustlib/target/
.opencode/_rustlib/_disabled/target/

# runtime crash artifacts + state
*.db.*
.opencode/.burst-state.json

# backup snapshot dirs (rule/skill pre-rewrite copies)
.backups/

# compound aggregator domains — _{abstract-noun}/ folders
# domain project contents live in their own repos; the root repo tracks
# the substrate _folders — bitacora, templates, impressions, scripts —
# with their contents, plus top-level placeholders
/_*/
!/_*/
!/_*/**/_bitacora/**
!/_*/**/_templates/**
!/_*/**/_impressions/**
!/_*/**/_scripts/**
!/_*/.gitkeep

# build artifacts inside tracked _folders stay out
**/_rustlib/target/
**/_golib/ann

# pdf research documents stay out
_trove/**/*.pdf



# node_modules stay out everywhere (after substrate un-ignore)
**/node_modules/
